# Copy to .env  (never commit the real file)

# ---- AI evaluation (any OpenAI-compatible API; Mistral by default) ----
LLM_API_KEY=
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest
# Old v1 name still works:  MISTRAL_API_KEY=

# ---- Speech-to-text (runs locally, no API needed) ----
# small.en = good default.  base.en = faster.  medium.en / distil-large-v3 = most accurate (needs more RAM/CPU)
WHISPER_MODEL=small.en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=3

# ---- Server ----
APP_ENV=development            # set to production when deployed
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # only needed if the UI is on another origin
MAX_ACTIVE_SESSIONS=3          # concurrent live interviews per container
RATE_LIMIT_PER_MIN=12          # new sessions per IP per minute
RETENTION_DAYS=30              # reports older than this are deleted automatically
STORE_TRANSCRIPTS=true         # false = keep scores only, never the transcript text
TRUST_PROXY=false              # true behind a reverse proxy / PaaS to read X-Forwarded-For
# API_KEY=                     # optional: require X-API-Key on session creation (private deployments)

# ---- Scoring weights (re-normalised automatically if a module is unavailable) ----
W_AUDIO=0.35
W_EXPRESSION=0.20
W_CONTENT=0.45
